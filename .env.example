# Copy to .env (backend) / set in your hosting dashboards. Never commit real keys.

# --- Frontend (Vercel project settings, or the shell before `npm run build`) ---
# Where the Next.js server proxies /api/*. Evaluated at BUILD time, so set it before building/deploying.
BACKEND_URL=https://your-spendiq-api.onrender.com

# --- Backend (Railway / Render environment variables) ---
# Optional. Narrative "Insight" cards use template text when this is empty.
GEMINI_API_KEY=
# Optional comma-separated extra origins allowed by CORS. Not needed when the frontend proxies /api/*.
CORS_ORIGINS=
